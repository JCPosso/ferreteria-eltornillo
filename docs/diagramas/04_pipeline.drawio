<mxfile host="app.diagrams.net"><diagram name="04_pipeline" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Pipeline CI/CD — GitHub Actions + OIDC + Terraform" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Desarrollador&lt;/b&gt;&lt;br&gt;git push /&lt;br&gt;Pull Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="150" height="90" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;CI (ci.yml)&lt;/b&gt;&lt;br&gt;• Lint&lt;br&gt;• 39 pruebas (bloqueantes)&lt;br&gt;• terraform fmt y validate&lt;br&gt;• Checkov (bloqueante)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1168BD;fontColor=#102A43;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="240" height="170" as="geometry"/></mxCell><mxCell id="mg" value="&lt;b&gt;Merge a main&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1168BD;fontColor=#102A43;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="110" height="50" as="geometry"/></mxCell><mxCell id="dd" value="&lt;b&gt;Deploy dev (deploy.yml)&lt;/b&gt;&lt;br&gt;• Login OIDC a Azure&lt;br&gt;• terraform plan&lt;br&gt;• Control de costos (bloqueante)&lt;br&gt;• terraform apply&lt;br&gt;• Deploy de la API&lt;br&gt;• Inicializa la base (Entra)&lt;br&gt;• Deploy del frontend&lt;br&gt;• Smoke test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D32;fontColor=#102A43;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="250" height="230" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Aprobación manual&lt;/b&gt;&lt;br&gt;(reviewer de prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontColor=#102A43;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="150" height="70" as="geometry"/></mxCell><mxCell id="dp" value="&lt;b&gt;Deploy prod&lt;/b&gt;&lt;br&gt;Mismos pasos con&lt;br&gt;Static Web Apps&lt;br&gt;Standard; el smoke test&lt;br&gt;entra por el SWA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D32;fontColor=#102A43;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="90" width="215" height="170" as="geometry"/></mxCell><mxCell id="p1" value="push / PR" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dev" target="ci"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2" value="verde" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ci" target="mg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3" value="" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mg" target="dd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4" value="smoke OK" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dd" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5" value="aprobado" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gate" target="dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x1" value="Si algo falla: no se despliega" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#C62828;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="266" width="240" height="40" as="geometry"/></mxCell><mxCell id="oidc" value="&lt;b&gt;Token OIDC de GitHub&lt;/b&gt;&lt;br&gt;(sin secretos guardados)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1168BD;fontColor=#102A43;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="400" width="190" height="80" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;credencial federada&lt;br&gt;(repo + environment)" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/identity/Azure_Active_Directory.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="56" height="56" as="geometry"/></mxCell><mxCell id="sub" value="&lt;b&gt;Azure for Students&lt;/b&gt;&lt;br&gt;rg-tornillo-dev · rg-tornillo-prod" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/general/Subscriptions.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="390" width="56" height="56" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Controles del pipeline&lt;/b&gt;&lt;br&gt;• Sin secretos en el repo: solo variables de GitHub (IDs)&lt;br&gt;• Estado de Terraform en Blob con Entra ID&lt;br&gt;• Un solo build, mismo código en dev y prod&lt;br&gt;• destroy.yml manual con confirmación&lt;br&gt;• Alerta de presupuesto y tope diario de logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9E9E9E;fontColor=#333333;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="480" height="190" as="geometry"/></mxCell><mxCell id="o1" value="" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#1168BD;fontSize=11;fontColor=#1168BD;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="dd" target="oidc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o2" value="intercambia" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#1168BD;fontSize=11;fontColor=#1168BD;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="oidc" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o3" value="token temporal" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#1168BD;fontSize=11;fontColor=#1168BD;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="entra" target="sub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o4" value="terraform apply&lt;br&gt;+ deploy" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#2E7D32;fontSize=11;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dp" target="sub"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>