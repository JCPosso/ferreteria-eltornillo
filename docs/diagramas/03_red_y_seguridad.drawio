<mxfile host="app.diagrams.net"><diagram name="03_red_y_seguridad" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Red y seguridad — zonas, controles y flujo de una consulta" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="zi" value="Internet (no confiable)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#C62828;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#C62828;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="230" height="560" as="geometry"/></mxCell><mxCell id="zb" value="Borde — Static Web Apps" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#E08A00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#E08A00;html=1;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="280" height="560" as="geometry"/></mxCell><mxCell id="zc" value="Cómputo — Function App" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#1168BD;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#1168BD;html=1;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="280" height="560" as="geometry"/></mxCell><mxCell id="zd" value="Datos (Entra ID + RBAC)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#2E7D32;html=1;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="390" height="560" as="geometry"/></mxCell><mxCell id="usr" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;del usuario" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="95" y="140" width="56" height="56" as="geometry"/></mxCell><mxCell id="ent" value="&lt;b&gt;Microsoft&lt;/b&gt;&lt;br&gt;Entra ID" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/identity/Azure_Active_Directory.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="56" height="56" as="geometry"/></mxCell><mxCell id="swa" value="&lt;b&gt;Static Web Apps&lt;/b&gt;" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/preview/Static_Apps.svg;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="64" height="64" as="geometry"/></mxCell><mxCell id="t1" value="• HTTPS obligatorio, TLS 1.2+&lt;br&gt;• Login con Entra ID&lt;br&gt;• /api/* solo "authenticated"&lt;br&gt;• /api/health anónimo&lt;br&gt;• Roles: admin, sede-1,&lt;br&gt;  sede-2, sede-3&lt;br&gt;• Cabeceras: CSP, X-Frame-&lt;br&gt;  Options, nosniff,&lt;br&gt;  Referrer-Policy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="285" y="250" width="255" height="300" as="geometry"/></mxCell><mxCell id="func" value="&lt;b&gt;Function App&lt;/b&gt;" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/compute/Function_Apps.svg;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="680" y="140" width="64" height="64" as="geometry"/></mxCell><mxCell id="mi" value="&lt;b&gt;Identidad&lt;/b&gt;&lt;br&gt;administrada" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/identity/Entra_Managed_Identities.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="56" height="56" as="geometry"/></mxCell><mxCell id="t2" value="• HTTPS only, TLS 1.2,&lt;br&gt;  FTPS apagado&lt;br&gt;• Valida rol y sede en&lt;br&gt;  cada llamada&lt;br&gt;• Entradas validadas,&lt;br&gt;  consultas parametrizadas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="585" y="290" width="190" height="120" as="geometry"/></mxCell><mxCell id="t3" value="• Sin contraseñas ni llaves&lt;br&gt;  en el código&lt;br&gt;• Mínimo privilegio:&lt;br&gt;  db_datareader + Key Vault&lt;br&gt;  Secrets User" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="585" y="510" width="255" height="100" as="geometry"/></mxCell><mxCell id="sql" value="&lt;b&gt;Azure SQL&lt;/b&gt;" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/databases/SQL_Database.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="56" height="56" as="geometry"/></mxCell><mxCell id="t4" value="• Solo autenticación Entra ID&lt;br&gt;• TLS 1.2, RLS por sede&lt;br&gt;• Firewall: solo servicios de Azure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="985" y="110" width="270" height="110" as="geometry"/></mxCell><mxCell id="kv" value="&lt;b&gt;Key Vault&lt;/b&gt;" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/security/Key_Vaults.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="56" height="56" as="geometry"/></mxCell><mxCell id="t5" value="• Autorización por RBAC&lt;br&gt;• Borrado suave 7 días" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="985" y="270" width="270" height="90" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Storage&lt;/b&gt;" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/storage/Storage_Accounts.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="56" height="56" as="geometry"/></mxCell><mxCell id="t6" value="• Contenedores privados&lt;br&gt;• Sin blobs públicos, TLS 1.2&lt;br&gt;• SAS con expiración de 1 día&lt;br&gt;• Retención de borrado 7 días" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="985" y="430" width="270" height="120" as="geometry"/></mxCell><mxCell id="f1" value="1 login" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#1168BD;fontSize=11;fontColor=#1168BD;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="usr" target="ent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="2 HTTPS (TLS 1.2+)" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="usr" target="swa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="3 /api/* + identidad&lt;br&gt;del usuario" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="swa" target="func"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="4 token de identidad&lt;br&gt;administrada" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="func" target="sql"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="5 secretos" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="func" target="kv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="5 Blob" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="func" target="st"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Riesgos aceptados (decisiones de costo, ver ADR de red y seguridad)&lt;/b&gt;&lt;br&gt;• Sin private endpoints: SQL, Storage y Key Vault tienen red pública protegida por Entra ID/RBAC y TLS 1.2 (los private endpoints exceden el tope de USD 150/mes).&lt;br&gt;• R11: la Function App podría aceptar llamadas directas con una cabecera de identidad falsificada; la prueba de humo del pipeline lo verifica y se restringirá el acceso si ocurre.&lt;br&gt;• El pipeline tiene Contributor y User Access Administrator sobre la suscripción de PENU (de uso exclusivo del proyecto)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#E08A00;fontColor=#102A43;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1240" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>