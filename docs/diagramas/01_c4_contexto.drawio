<mxfile host="app.diagrams.net"><diagram name="01_c4_contexto" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="C4 nivel 1 — Contexto del sistema de inventario de Ferretería "El Tornillo"" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="emp" value="&lt;b&gt;Empleado de sede&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Consulta el inventario de su sede&lt;br&gt;(roles sede-1, sede-2, sede-3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="250" height="120" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b&gt;Dueño / administrador&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Consulta las 3 sedes y recibe&lt;br&gt;el reporte semanal (rol admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="250" height="120" as="geometry"/></mxCell><mxCell id="sis" value="&lt;b&gt;Sistema de inventario&lt;/b&gt;&lt;br&gt;[Sistema de software]&lt;br&gt;Inventario compartido de las 3 sedes:&lt;br&gt;consulta, carga diaria de CSV&lt;br&gt;y reporte semanal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="225" width="290" height="160" as="geometry"/></mxCell><mxCell id="ent" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Inicio de sesión y roles de usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="270" height="110" as="geometry"/></mxCell><mxCell id="pos" value="&lt;b&gt;Punto de venta de cada sede&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Exporta un CSV diario de existencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="245" width="270" height="110" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;[Sistema externo — por definir]&lt;br&gt;Entrega el reporte semanal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="270" height="110" as="geometry"/></mxCell><mxCell id="e1" value="Consulta inventario&lt;br&gt;[HTTPS]" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="emp" target="sis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Consulta y recibe reportes&lt;br&gt;[HTTPS]" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adm" target="sis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Autentica usuarios&lt;br&gt;[OIDC]" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sis" target="ent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Envía CSV diario&lt;br&gt;[Blob Storage]" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos" target="sis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Envía reporte semanal" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sis" target="mail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="Leyenda: azul oscuro = persona · azul = sistema que se construye · gris = sistema externo. Alcance del MVP: consulta de inventario por sede." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>